# Copiar como .env y completar. El archivo .env nunca se versiona.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1

# PostgreSQL (servicio `db` de Docker Compose)
POSTGRES_DB=triage
POSTGRES_USER=triage
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_S=9

# Triage
TRIAGE_USAR_CACHE=1
TRIAGE_CONFIG_DIR=config
